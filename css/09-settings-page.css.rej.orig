+/* ==== Show holidays from (#shol): each country is chosen on its own, so a chosen one carries a tick; two filled
+   buttons side by side read as one choice gone wrong (Satish, 2026-11-15). The tick is drawn, so it needs no font ==== */
+#shol button[aria-pressed="true"]::before {
+  content: "";
+  display: inline-block;
+  width: 0.34em;
+  height: 0.62em;
+  margin: 0 0.55em 0.12em 0;
+  border: solid currentColor;
+  border-width: 0 2px 2px 0;
+  transform: rotate(45deg);
+}
